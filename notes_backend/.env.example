# Notes Backend Environment Variables

# Port for the HTTP server
PORT=4000

# CORS allowed origin for the frontend (set to your frontend URL)
CORS_ORIGIN=http://localhost:3000

# JSON DB path for lowdb adapter; if not provided, defaults to ../notes_database/seed.notes.json
# Use a writable path for development, e.g., ./data/notes.json
NOTES_DB_JSON_PATH=./data/notes.json
