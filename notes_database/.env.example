# Backend persistence configuration for Notes app
# Use either JSON or SQLite; set the appropriate path.

# JSON file store (MVP)
NOTES_DB_JSON_PATH=./data/notes.json

# SQLite (optional alternative)
# NOTES_DB_SQLITE_PATH=./data/notes.sqlite

# Frontend uses this variable (in its own environment) for API base URL:
# REACT_APP_API_BASE_URL=http://localhost:4000
