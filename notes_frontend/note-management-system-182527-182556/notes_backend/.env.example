# Backend environment variables for Notes backend

# HTTP port for the backend server
PORT=4000

# Allowed CORS origin for the frontend app (CRA dev server runs on 3000)
CORS_ORIGIN=http://localhost:3000

# Path to the JSON database file; default points to the seed file if not set.
# For writable development store, set to ./data/notes.json (will be created if missing)
# NOTES_DB_JSON_PATH=./data/notes.json
